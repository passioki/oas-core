        "text": "'S: 阴阳寮 → 寮结界'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "12"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiUtilize_I_REALM_SHIN') or appear('legacy_KekkaiUtilize_I_SHI_DEFENSE')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiUtilize_I_PLANT_TREE_CLOSE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_KekkaiUtilize_I_PLANT_TREE_CLOSE",
