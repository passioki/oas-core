        "sel": "legacy_GameUi_I_MAIN_GOTO_GUILD",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_GUILD",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "log",
      "args": {
