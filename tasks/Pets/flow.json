{
  "schema_version": 1,
  "name": "Pets",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"Pets 开始：庭院 → 宠物小屋 → 快速喂养 → 返回庭院\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "8"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Pets_I_PET_FEAST')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Pets_I_PET_HOUSE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_Pets_I_PET_HOUSE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_Pets_I_PET_HOUSE",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.5
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Pets_I_PET_CLAW')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_Pets_I_PET_CLAW",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_Pets_I_PET_CLAW",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.5
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_Pets_I_PET_FEAST"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"已进入宠物界面\""
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "param('feed')"
      },
      "then": [
        {
          "op": "click",
          "args": {
            "sel": "legacy_Pets_I_PET_FEAST",
            "requires": {
              "kind": "appear",
              "sel": "legacy_Pets_I_PET_FEAST",
              "timeout_ms": 3000
            },
            "expect": {
              "kind": "appear",
              "sel": "legacy_Pets_I_PET_FEED",
              "timeout_ms": 8000
            }
          }
        },
        {
          "op": "if",
          "args": {
            "cond": "ocr_digit('legacy_Pets_O_PET_FEED_AP') == 0"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "warn",
                "text": "\"体力为 0：今天已经投喂过（与旧仓 O_PET_FEED_AP==0 判定等价）\""
              }
            }
          ],
          "else": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"开始快速喂养\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_Pets_I_PET_FEED",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_Pets_I_PET_FEED",
                  "timeout_ms": 3000
                },
                "expect": {
                  "kind": "appear",
                  "sel": "legacy_Pets_I_PET_SKIP",
                  "timeout_ms": 10000
                }
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "30"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "not appear('legacy_Pets_I_PET_SKIP')"
                  },
                  "then": [
                    {
                      "op": "break"
                    }
                  ],
                  "else": []
                }
              ]
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"喂养动画结束\""
              }
            }
          ]
        }
      ],
      "else": []
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_Pets_I_PET_EXIT",
        "requires": {
          "kind": "appear",
          "sel": "legacy_Pets_I_PET_EXIT",
          "timeout_ms": 5000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 15000
        }
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"Pets done，已回到庭院\""
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "done"
      }
    }
  ]
}
