{
  "schema_version": 1,
  "name": "Dokan",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 寮道馆突入 开始（庭院 → 阴阳寮 → 神社 → 道馆）'"
      }
    },
    {
      "op": "set_var",
      "args": {
        "name": "exit",
        "value": "'done'"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 庭院 → 阴阳寮'"
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_MAIN_GOTO_GUILD",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_GUILD",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "14"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_CENTER_TOP') or appear('legacy_Dokan_I_RYOU_DOKAN_FINDING_DOKAN') or appear('legacy_Dokan_I_RYOU_DOKAN_FOUND_DOKAN') or appear('legacy_Dokan_I_RYOU_DOKAN_GATHERING')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 已进入道馆场景'"
              }
            },
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Dokan_I_SCENE_SHENSHE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_Dokan_I_RYOU_DOKAN",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_Dokan_I_RYOU_DOKAN",
                  "timeout_ms": 3000
                }
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_SCENE_RYOU') or appear('legacy_Dokan_I_RYOU_SHENSHE')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_Dokan_I_RYOU_SHENSHE",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Dokan_I_RYOU_SHENSHE",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "not (appear('legacy_Dokan_I_RYOU_DOKAN_CENTER_TOP') or appear('legacy_Dokan_I_RYOU_DOKAN_FINDING_DOKAN') or appear('legacy_Dokan_I_RYOU_DOKAN_FOUND_DOKAN') or appear('legacy_Dokan_I_RYOU_DOKAN_GATHERING'))"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "warn",
            "text": "'S: 14 次尝试仍未进入道馆场景 → failed(retryable)'"
          }
        },
        {
          "op": "set_var",
          "args": {
            "name": "exit",
            "value": "'failed'"
          }
        }
      ],
      "else": []
    },
    {
      "op": "wait",
      "args": {
        "seconds": 2.0
      }
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "'S: 道馆场景检测（初始场景判定由 15 种 scene 模板完成；动态选馆/战斗/投票未迁移）'"
      }
    },
    {
      "op": "set_var",
      "args": {
        "name": "loops",
        "value": "0"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'done'"
      },
      "then": [
        {
          "op": "while",
          "args": {
            "cond": "var('loops') < 60"
          },
          "body": [
            {
              "op": "inc_var",
              "args": {
                "name": "loops",
                "by": 1
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_FINDING_DOKAN')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "warn",
                    "text": "'S: 处于「寻找道馆」场景：动态列表扫描 + 赏金/人数评分 + 创建道馆 未迁移（spec ⛔）'"
                  }
                },
                {
                  "op": "set_var",
                  "args": {
                    "name": "exit",
                    "value": "'no_target'"
                  }
                },
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_FOUND_DOKAN')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "warn",
                    "text": "'S: 已找到道馆：进入寮境需要 O_DOKAN_MAP OCR 关键字框 + 偏移点击，DSL 无法表达（spec ⛔）'"
                  }
                },
                {
                  "op": "set_var",
                  "args": {
                    "name": "exit",
                    "value": "'no_target'"
                  }
                },
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_GATHERING')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 道馆集结中 → 等待'"
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_DOKAN_BOSS_WAITING')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 等待馆主战 → 等待'"
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_MASTER_BATTLE') and appear('legacy_Dokan_I_RYOU_DOKAN_START_CHALLENGE')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 馆主战可挑战 → 点右下角挑战（馆主双阵容战斗未迁移，见 spec ⛔）'"
                  }
                },
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_Dokan_I_RYOU_DOKAN_START_CHALLENGE",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Dokan_I_RYOU_DOKAN_START_CHALLENGE",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_BATTLE_MASTER_FIRST') or appear('legacy_Dokan_I_RYOU_DOKAN_BATTLE_MASTER_SECOND') or appear('legacy_Dokan_I_RYOU_DOKAN_IN_FIELD')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "warn",
                    "text": "'S: 已进入战斗（馆主/寮境），战斗流程未迁移（spec ⛔）→ no_target(blocked)'"
                  }
                },
                {
                  "op": "set_var",
                  "args": {
                    "name": "exit",
                    "value": "'no_target'"
                  }
                },
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_CD')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "warn",
                    "text": "'S: 道馆失败 CD 中（自动加油未迁移）→ 等待'"
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_START_CHALLENGE')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 右下角挑战按钮 → 点击进入战斗'"
                  }
                },
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_Dokan_I_RYOU_DOKAN_START_CHALLENGE",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Dokan_I_RYOU_DOKAN_START_CHALLENGE",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_BATTLE_OVER') or appear('legacy_Dokan_I_RYOU_DOKAN_TOPPA_RANK') or appear('legacy_Component_GeneralBattle_I_WIN') or appear('legacy_Component_GeneralBattle_I_FALSE')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 战斗结算/排名界面 → 点关闭区域'"
                  }
                },
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_Dokan_C_DOKAN_TOPPA_RANK_CLOSE_AREA"
                      }
                    ]
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_ABANDONED_TOPPA_CONTINUE')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 放弃突破投票 → 选「放弃」'"
                  }
                },
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_Dokan_I_RYOU_DOKAN_ABANDONED_TOPPA_ABANDONED",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Dokan_I_RYOU_DOKAN_ABANDONED_TOPPA_ABANDONED",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_FAILED_VOTE_KEEP_BOUNTY')"
              },
              "then": [
                {
                  "op": "if",
                  "args": {
                    "cond": "param('daily_attack_count') >= 2 and appear('legacy_Dokan_I_RYOU_DOKAN_FAILED_VOTE_BATTLE_AGAIN')"
                  },
                  "then": [
                    {
                      "op": "log",
                      "args": {
                        "level": "info",
                        "text": "'S: 失败投票 → 再战道馆'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Dokan_I_RYOU_DOKAN_FAILED_VOTE_BATTLE_AGAIN",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Dokan_I_RYOU_DOKAN_FAILED_VOTE_BATTLE_AGAIN",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "log",
                      "args": {
                        "level": "info",
                        "text": "'S: 失败投票 → 保留赏金'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Dokan_I_RYOU_DOKAN_FAILED_VOTE_KEEP_BOUNTY",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Dokan_I_RYOU_DOKAN_FAILED_VOTE_KEEP_BOUNTY",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ]
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_WIN') or appear('legacy_Dokan_I_RYOU_DOKAN_SPOILS_OF_DOKAN')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 道馆胜利界面 → 点关闭区域'"
                  }
                },
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_Dokan_C_DOKAN_TOPPA_RANK_CLOSE_AREA"
                      }
                    ]
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_CENTER_TOP') and (appear('legacy_Dokan_I_RYOU_DOKAN_TODAY_ATTACK_COUNT') or appear('legacy_Dokan_I_RYOU_DOKAN_REMAIN_ATTACK_COUNT_DONE'))"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "'S: 道馆已结束 → done'"
                  }
                },
                {
                  "op": "set_var",
                  "args": {
                    "name": "exit",
                    "value": "'done'"
                  }
                },
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        }
      ],
      "else": []
    },
    {
      "op": "loop",
      "args": {
        "n": "15"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_QUIT_BATTLE_ENSURE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_Dokan_I_RYOU_DOKAN_QUIT_BATTLE_ENSURE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_Dokan_I_RYOU_DOKAN_QUIT_BATTLE_ENSURE",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Dokan_I_RYOU_DOKAN_DOKAN_QUIT')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_Dokan_I_RYOU_DOKAN_DOKAN_QUIT",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_Dokan_I_RYOU_DOKAN_DOKAN_QUIT",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_BLUE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_BLUE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_BLUE",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_BACK_Y')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GameUi_I_BACK_Y",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GameUi_I_BACK_Y",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                  "timeout_ms": 2000
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.5
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 道馆突入结束（部分）'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'no_target'"
      },
      "then": [
        {
          "op": "finish",
          "args": {
            "exit": "no_target"
          }
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "var('exit') == 'done'"
          },
          "then": [
            {
              "op": "finish",
              "args": {
                "exit": "done"
              }
            }
          ],
          "else": [
            {
              "op": "finish",
              "args": {
                "exit": "failed"
              }
            }
          ]
        }
      ]
    }
  ]
}
