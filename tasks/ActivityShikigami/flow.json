      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 活动爬塔结束'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'no_target'"
      },
      "then": [
        {
          "op": "finish",
          "args": {
            "exit": "no_target"
          }
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "var('exit') == 'no_resource'"
          },
          "then": [
            {
              "op": "finish",
              "args": {
                "exit": "no_resource"
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "var('exit') == 'failed'"
              },
              "then": [
                {
                  "op": "finish",
                  "args": {
                    "exit": "failed"
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "var('exit') == 'done'"
                  },
                  "then": [
                    {
                      "op": "finish",
                      "args": {
                        "exit": "done"
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "finish",
                      "args": {
                        "exit": "failed"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
