              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_CIRCLE')"
