                          "kind": "appear",
                          "sel": "战斗_准备按钮",
                          "timeout_ms": 2000
                        },
                        "expect": {
                          "kind": "vanish",
                          "sel": "战斗_准备按钮",
                          "timeout_ms": 12000
                        },
                        "retry": {
                          "times": 2,
                          "delay_ms": 600,
                          "exponential": false
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_WIN') or appear('legacy_Component_GeneralBattle_I_DE_WIN')"
