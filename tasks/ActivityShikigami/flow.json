                        },
                        "retry": {
                          "times": 2,
                          "delay_ms": 600,
                          "exponential": false
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('战斗_准备按钮')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "战斗_准备按钮",
