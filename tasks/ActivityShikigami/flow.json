              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_ActivityShikigami_I_PASS_6",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_ActivityShikigami_I_PASS_6",
                      "timeout_ms": 2500
                    }
                  }
                }
