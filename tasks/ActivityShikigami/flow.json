            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM_SAMLL')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_CONFIRM_SAMLL",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_CONFIRM_SAMLL",
                      "timeout_ms": 2000
