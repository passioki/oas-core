              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_ActivityShikigami_I_TO_BATTLE_MAIN_2')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_ActivityShikigami_I_TO_BATTLE_MAIN_2",
