          "op": "set_var",
          "args": {
            "name": "exit",
            "value": "'no_target'"
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'done'"
      },
      "then": [
        {
          "op": "set_var",
          "args": {
            "name": "battles",
            "value": "0"
          }
        },
        {
          "op": "while",
          "args": {
            "cond": "var('battles') < param('max_battles')"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM')"
              },
