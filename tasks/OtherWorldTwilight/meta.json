{
  "schema_version": 1,
  "template_version": 1,
  "task_id": "OtherWorldTwilight",
  "name": "OtherWorldTwilight",
  "version": 1,
  "expire": "weekly",
  "category": "weekly",
  "description": "庭院→町中→逢魔之时→彼世逢魔。按 param user_status 分支：alone（默认）=check_lock(False) 保持未锁队→循环挑战→通用战斗→回庭院；leader/member 模式（建房/邀请/等待房间）未迁移，走 failed 出口并记录 blocker。上游默认 leader，本迁移默认 alone 以便可用；细节见 migration/specs/OtherWorldTwilight.md。",
  "entry": {
    "requires": {
      "kind": "appear",
      "sel": "庭院_探索灯笼",
      "timeout_ms": 3000
    }
  },
  "params": [
    {
      "key": "user_status",
      "type": "string",
      "default": "alone"
    },
    {
      "key": "max_battles",
      "type": "int",
      "default": 30,
      "min": 1,
      "max": 99
    }
  ],
  "exits": {
    "done": {
      "result": "success"
    },
    "failed": {
      "result": "retryable"
    },
    "no_resource": {
      "result": "resource"
    },
    "no_target": {
      "result": "blocked"
    },
    "window_closed": {
      "result": "retryable"
    }
  },
  "capabilities": {
    "checkpoint": true,
    "interruptible": false,
    "duration_hint_s": 1800
  },
  "resources": [],
  "schedule_hint": {
    "windows": [],
    "quota": {
      "per": "week",
      "times": 7
    }
  }
}
