                      "then": [],
                      "else": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_KittyShop_I_MAIN_BUSY_3",
                            "requires": {
                              "kind": "appear",
                              "sel": "legacy_KittyShop_I_MAIN_BUSY_3",
                              "timeout_ms": 3000
                            }
                          }
                        }
                      ]
                    },
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_4')"
                      },
                      "then": [],
                      "else": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_KittyShop_I_MAIN_BUSY_4",
                            "requires": {
                              "kind": "appear",
                              "sel": "legacy_KittyShop_I_MAIN_BUSY_4",
                              "timeout_ms": 3000
                            }
                          }
                        }
                      ]
                    },
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_5')"
                      },
                      "then": [],
                      "else": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_KittyShop_I_MAIN_BUSY_5",
                            "requires": {
                              "kind": "appear",
                              "sel": "legacy_KittyShop_I_MAIN_BUSY_5",
                              "timeout_ms": 3000
                            }
                          }
                        }
                      ]
                    }
                  ],
                  "else": []
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                }
              ]
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"经营结算，回到经营入口页\""
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "15"
              },
              "body": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_START_FARMING')"
                  },
                  "then": [
                    {
                      "op": "break"
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_FLAG1')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_FLAG1",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_FLAG1",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.5
                  }
                }
              ]
            }
          ]
        },
        {
          "op": "loop",
          "args": {
            "n": "12"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
