            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                      "timeout_ms": 3000
                    }
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.2
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"KittyShop 返回庭院\""
          }
        },
        {
          "op": "finish",
          "args": {
            "exit": "skipped"
          }
        }
      ]
    }
  ]
}
