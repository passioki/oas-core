                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                      "timeout_ms": 3000
                    }
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.2
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"KittyShop 返回庭院\""
          }
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"KittyShop done\""
          }
        },
        {
          "op": "finish",
          "args": {
            "exit": "done"
          }
        }
      ],
      "else": [
        {
          "op": "log",
          "args": {
            "level": "warn",
            "text": "\"猫咪商店活动未开启（20 轮入口探测未出现 I_START_FARMING）：no-op 结束，不报错\""
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "12"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
