{
  "schema_version": 1,
  "name": "KittyShop",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "debug",
        "text": "\"main reset prelude\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "5"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "click_point",
          "args": {
            "x": 44,
            "y": 31
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "not appear('ui_main_bar_guide')"
      },
      "then": [
        {
          "op": "click_point",
          "args": {
            "x": 1200,
            "y": 680
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.5
          }
        }
      ],
      "else": []
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"KittyShop 开始：庭院 → 猫咪商店（活动是否开启先探测，未开启则 no-op 结束）\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "20"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KittyShop_I_START_FARMING')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KittyShop_I_GO1')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_KittyShop_I_GO1",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_KittyShop_I_GO1",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_ActivityShikigami_I_SHI')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_ActivityShikigami_I_SHI",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_ActivityShikigami_I_SHI",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_KittyShop_I_START_FARMING')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"已进入猫咪商店经营页\""
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "param('attempts')"
          },
          "body": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"选择猫咪\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_KittyShop_I_START_FARMING",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_KittyShop_I_START_FARMING",
                  "timeout_ms": 3000
                },
                "expect": {
                  "kind": "appear",
                  "sel": "legacy_KittyShop_I_START_ENSURE",
                  "timeout_ms": 8000
                }
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "5"
              },
              "body": [
                {
                  "op": "if",
                  "args": {
                    "cond": "not appear('legacy_KittyShop_I_UNSELECTED')"
                  },
                  "then": [
                    {
                      "op": "break"
                    }
                  ],
                  "else": []
                },
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_KittyShop_C_SELECT_1"
                      }
                    ]
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.2
                  }
                },
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_KittyShop_C_SELECT_2"
                      }
                    ]
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.2
                  }
                },
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_KittyShop_C_SELECT_3"
                      }
                    ]
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.2
                  }
                },
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_KittyShop_C_SELECT_4"
                      }
                    ]
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.2
                  }
                },
                {
                  "op": "swipe",
                  "args": {
                    "from": [
                      599,
                      368
                    ],
                    "to": [
                      470,
                      369
                    ],
                    "ms": 500
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                }
              ]
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"开始经营\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_KittyShop_I_START_ENSURE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_KittyShop_I_START_ENSURE",
                  "timeout_ms": 3000
                },
                "expect": {
                  "kind": "appear",
                  "sel": "legacy_KittyShop_I_MAIN_FLAG",
                  "timeout_ms": 8000
                }
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "240"
              },
              "body": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_SHARE')"
                  },
                  "then": [
                    {
                      "op": "break"
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "param('quit_when_finished')"
                  },
                  "then": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                            "requires": {
                              "kind": "appear",
