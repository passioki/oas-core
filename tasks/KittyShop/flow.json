                          "timeout_ms": 3000
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_ADD')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_ADD",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_ADD",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_FLAG1')"
                  },
                  "then": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_1')"
                      },
                      "then": [],
                      "else": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_KittyShop_I_MAIN_BUSY_1",
                            "requires": {
                              "kind": "appear",
                              "sel": "legacy_KittyShop_I_MAIN_BUSY_1",
                              "timeout_ms": 3000
                            }
                          }
                        }
                      ]
                    },
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_2')"
                      },
                      "then": [],
                      "else": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_KittyShop_I_MAIN_BUSY_2",
                            "requires": {
                              "kind": "appear",
                              "sel": "legacy_KittyShop_I_MAIN_BUSY_2",
                              "timeout_ms": 3000
                            }
                          }
                        }
                      ]
                    },
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_3')"
