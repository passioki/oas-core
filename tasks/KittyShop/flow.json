                      "else": []
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_GIFT')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_GIFT",
