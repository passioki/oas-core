{
  "schema_version": 1,
  "name": "KittyShop",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"KittyShop 开始：庭院 → 猫咪商店 → 选择猫咪 → 经营 → 收菜循环\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "30"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KittyShop_I_START_FARMING')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KittyShop_I_GO1')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_KittyShop_I_GO1",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_KittyShop_I_GO1",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_ActivityShikigami_I_SHI')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_ActivityShikigami_I_SHI",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_ActivityShikigami_I_SHI",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_KittyShop_I_START_FARMING"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"已进入猫咪商店经营页\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "param('attempts')"
      },
      "body": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"选择猫咪\""
          }
        },
        {
          "op": "click",
          "args": {
            "sel": "legacy_KittyShop_I_START_FARMING",
            "requires": {
              "kind": "appear",
              "sel": "legacy_KittyShop_I_START_FARMING",
              "timeout_ms": 3000
            },
            "expect": {
              "kind": "appear",
              "sel": "legacy_KittyShop_I_START_ENSURE",
              "timeout_ms": 8000
            }
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "5"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "not appear('legacy_KittyShop_I_UNSELECTED')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "click_target",
              "args": {
                "find": [
                  {
                    "kind": "region",
                    "sel": "legacy_KittyShop_C_SELECT_1"
                  }
                ]
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            },
            {
              "op": "click_target",
              "args": {
                "find": [
                  {
                    "kind": "region",
                    "sel": "legacy_KittyShop_C_SELECT_2"
                  }
                ]
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            },
            {
              "op": "click_target",
              "args": {
                "find": [
                  {
                    "kind": "region",
                    "sel": "legacy_KittyShop_C_SELECT_3"
                  }
                ]
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            },
            {
              "op": "click_target",
              "args": {
                "find": [
                  {
                    "kind": "region",
                    "sel": "legacy_KittyShop_C_SELECT_4"
                  }
                ]
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            },
            {
              "op": "swipe",
              "args": {
                "from": [
                  599,
                  368
                ],
                "to": [
                  470,
                  369
                ],
                "ms": 500
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"开始经营\""
          }
        },
        {
          "op": "click",
          "args": {
            "sel": "legacy_KittyShop_I_START_ENSURE",
            "requires": {
              "kind": "appear",
              "sel": "legacy_KittyShop_I_START_ENSURE",
              "timeout_ms": 3000
            },
            "expect": {
              "kind": "appear",
              "sel": "legacy_KittyShop_I_MAIN_FLAG",
              "timeout_ms": 8000
            }
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "240"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KittyShop_I_MAIN_SHARE')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "param('quit_when_finished')"
              },
              "then": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM_SAMLL')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_CONFIRM_SAMLL",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_GlobalGame_I_UI_CONFIRM_SAMLL",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_FINSH')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_FINSH",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_FINSH",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ],
                  "else": []
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KittyShop_I_MAIN_GIFT')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_KittyShop_I_MAIN_GIFT",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_KittyShop_I_MAIN_GIFT",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KittyShop_I_MAIN_ADD')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_KittyShop_I_MAIN_ADD",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_KittyShop_I_MAIN_ADD",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KittyShop_I_MAIN_FLAG1')"
              },
              "then": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_1')"
                  },
                  "then": [],
                  "else": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_BUSY_1",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_BUSY_1",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_2')"
                  },
                  "then": [],
                  "else": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_BUSY_2",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_BUSY_2",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_3')"
                  },
                  "then": [],
                  "else": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_BUSY_3",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_BUSY_3",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_4')"
                  },
                  "then": [],
                  "else": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_BUSY_4",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_BUSY_4",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KittyShop_I_MAIN_BUSY_5')"
                  },
                  "then": [],
                  "else": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KittyShop_I_MAIN_BUSY_5",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KittyShop_I_MAIN_BUSY_5",
                          "timeout_ms": 3000
                        }
                      }
                    }
                  ]
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"经营结算，回到经营入口页\""
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "15"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KittyShop_I_START_FARMING')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KittyShop_I_MAIN_FLAG1')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_KittyShop_I_MAIN_FLAG1",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_KittyShop_I_MAIN_FLAG1",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.5
              }
            }
          ]
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"KittyShop 结束，返回庭院\""
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 15000
        }
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"KittyShop done\""
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "done"
      }
    }
  ]
}
