{
  "schema_version": 1,
  "name": "DemonEncounter",
  "steps": [
    {
      "op": "if",
      "args": {
        "cond": "not appear('ui_main_bar_guide')"
      },
      "then": [
        {
          "op": "click_point",
          "args": {
            "x": 1200,
            "y": 680
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.5
          }
        }
      ],
      "else": []
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 逢魔之时 开始（庭院 → 町中 → 逢魔 → 现世逢魔）'"
      }
    },
    {
      "op": "set_var",
      "args": {
        "name": "exit",
        "value": "'done'"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 庭院 → 町中'"
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_MAIN_GOTO_TOWN",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_TOWN",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_TOWN_GOTO_DEMON_ENCOUNTER",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_TOWN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_DEMON_ENCOUNTER_2",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.5
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_GameUi_I_CHECK_DEMON_ENCOUNTER_REALWORLD')"
      },
      "then": [],
      "else": [
        {
          "op": "click",
          "args": {
            "sel": "legacy_GameUi_I_DEMON_ENCOUNTER_REALWORLD_GOTO",
            "requires": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_DEMON_ENCOUNTER_REALWORLD_GOTO",
              "timeout_ms": 4000
            },
            "expect": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_CHECK_DEMON_ENCOUNTER_REALWORLD",
              "timeout_ms": 12000
            }
          }
        }
      ]
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.5
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "ocr_digit('legacy_DemonEncounter_O_DE_CHALLENGE_COUNT') == 0"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 今日逢魔挑战次数 0 → 已挑战，结束'"
          }
        },
        {
          "op": "set_var",
          "args": {
            "name": "exit",
            "value": "'skipped'"
          }
        }
      ],
      "else": []
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'done'"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 点亮四处灯笼（旧 execute_lantern 的填充部分）'"
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "10"
          },
          "body": [
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DemonEncounter_I_DE_AWARD')"
              },
              "then": [
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DemonEncounter_I_DE_FIND')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_DemonEncounter_I_DE_FIND",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_DemonEncounter_I_DE_FIND",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            }
          ]
        },
        {
          "op": "loop",
          "args": {
            "n": "8"
          },
          "body": [
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DemonEncounter_I_DE_AWARD')"
              },
              "then": [
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_REWARD')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_REWARD",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_REWARD",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            }
          ]
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 灯笼类型处理（box/mail/realm/mystery/battle/boss）未迁移，见 spec TODO'"
          }
        }
      ],
      "else": []
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'done'"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 寻找逢魔首领（普通/极）'"
          }
        },
        {
          "op": "set_var",
          "args": {
            "name": "tries",
            "value": "0"
          }
        },
        {
          "op": "while",
          "args": {
            "cond": "var('tries') < 12"
          },
          "body": [
            {
              "op": "inc_var",
              "args": {
                "name": "tries",
                "by": 1
              }
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DemonEncounter_I_BOSS_FIRE') or appear('legacy_DemonEncounter_I_BEST_BOSS_FIRE')"
              },
              "then": [
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DemonEncounter_I_DE_BOX_CENTER')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_DemonEncounter_I_DE_LOCATION",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_DemonEncounter_I_DE_LOCATION",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DemonEncounter_I_JADE_50')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_DemonEncounter_I_DE_FIND",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_DemonEncounter_I_DE_FIND",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DemonEncounter_I_DE_BOSS_BEST')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_DemonEncounter_I_DE_BOSS_BEST",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_DemonEncounter_I_DE_BOSS_BEST",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_DE_BOSS')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_DemonEncounter_I_DE_BOSS",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_DemonEncounter_I_DE_BOSS",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": []
                }
              ]
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            },
            {
              "op": "click_target",
              "args": {
                "find": [
                  {
                    "kind": "region",
                    "sel": "legacy_DemonEncounter_C_DM_BOSS_CLICK"
                  }
                ]
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "6"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_BOSS_FIRE') or appear('legacy_DemonEncounter_I_BEST_BOSS_FIRE')"
                  },
                  "then": [
                    {
                      "op": "break",
                      "args": {}
                    }
                  ],
                  "else": []
                }
              ]
            }
          ]
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DemonEncounter_I_BOSS_FIRE') or appear('legacy_DemonEncounter_I_BEST_BOSS_FIRE')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 点击集结进入 boss'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "8"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.2
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_BOSS_GATHER')"
                  },
                  "then": [
                    {
                      "op": "break",
                      "args": {}
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_BOSS_CONFIRM')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_DemonEncounter_I_BOSS_CONFIRM",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_DemonEncounter_I_BOSS_CONFIRM",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_BOSS_FIRE')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_DemonEncounter_I_BOSS_FIRE",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_DemonEncounter_I_BOSS_FIRE",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_DemonEncounter_I_BEST_BOSS_FIRE')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_DemonEncounter_I_BEST_BOSS_FIRE",
                            "requires": {
                              "kind": "appear",
                              "sel": "legacy_DemonEncounter_I_BEST_BOSS_FIRE",
                              "timeout_ms": 2500
                            }
                          }
                        }
                      ],
                      "else": []
                    }
                  ]
                }
              ]
            },
            {
              "op": "loop",
              "args": {
                "n": "20"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 2.0
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_BOSS_DONE_CHECK')"
                  },
                  "then": [
                    {
                      "op": "break",
                      "args": {}
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_BOSS_GATHER')"
                  },
                  "then": [
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 2.0
                      }
                    }
                  ],
                  "else": []
                }
              ]
            },
            {
              "op": "wait_until",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT') or appear('legacy_Component_GeneralBattle_I_BATTLE_INFO') or appear('战斗_准备按钮') or appear('战斗_自动按钮')",
                "timeout_s": 30
              }
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 进入战斗（自动战斗），处理 准备/胜利/失败/奖励 直到回到原页面'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "60"
              },
              "body": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                          "timeout_ms": 2000
                        },
                        "expect": {
                          "kind": "vanish",
                          "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                          "timeout_ms": 12000
                        },
                        "retry": {
                          "times": 2,
                          "delay_ms": 600,
                          "exponential": false
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('战斗_准备按钮')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "战斗_准备按钮",
                        "requires": {
                          "kind": "appear",
                          "sel": "战斗_准备按钮",
                          "timeout_ms": 2000
                        },
                        "expect": {
                          "kind": "vanish",
                          "sel": "战斗_准备按钮",
                          "timeout_ms": 12000
                        },
                        "retry": {
                          "times": 2,
                          "delay_ms": 600,
                          "exponential": false
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_WIN') or appear('legacy_Component_GeneralBattle_I_DE_WIN')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "region",
                            "sel": "legacy_Component_GeneralBattle_C_WIN_1"
                          }
                        ]
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_FALSE')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_FALSE",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_FALSE",
                          "timeout_ms": 2000
                        },
                        "retry": {
                          "times": 2,
                          "delay_ms": 600,
                          "exponential": false
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_REWARD') or appear('legacy_Component_GeneralBattle_I_REWARD_GOLD')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "region",
                            "sel": "legacy_Component_GeneralBattle_C_RANDOM_LEFT"
                          }
                        ]
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 2.0
                  }
                },
                {
                  "op": "click_point",
                  "args": {
                    "x": 640,
                    "y": 690
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_DemonEncounter_I_BOSS_DONE_CHECK')"
                  },
                  "then": [
                    {
                      "op": "break",
                      "args": {}
                    }
                  ],
                  "else": []
                }
              ]
            },
            {
              "op": "appear",
              "args": {
                "sel": "legacy_DemonEncounter_I_BOSS_DONE_CHECK"
              }
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 逢魔 boss 战斗结束'"
              }
            }
          ],
          "else": [
            {
              "op": "log",
              "args": {
                "level": "warn",
                "text": "'S: 12 次尝试未找到/进入 boss → failed(retryable)'"
              }
            },
            {
              "op": "set_var",
              "args": {
                "name": "exit",
                "value": "'failed'"
              }
            }
          ]
        }
      ],
      "else": []
    },
    {
      "op": "loop",
      "args": {
        "n": "12"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_TOWN')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GameUi_I_TOWN_GOTO_MAIN",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GameUi_I_CHECK_TOWN",
                  "timeout_ms": 3000
                },
                "expect": {
                  "kind": "appear",
                  "sel": "legacy_GameUi_I_CHECK_MAIN",
                  "timeout_ms": 12000
                }
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM_SAMLL')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_GlobalGame_I_UI_CONFIRM_SAMLL",
                            "requires": {
                              "kind": "appear",
                              "sel": "legacy_GlobalGame_I_UI_CONFIRM_SAMLL",
                              "timeout_ms": 2000
                            }
                          }
                        }
                      ],
                      "else": [
                        {
                          "op": "break",
                          "args": {}
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.5
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 逢魔之时结束'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'failed'"
      },
      "then": [
        {
          "op": "finish",
          "args": {
            "exit": "failed"
          }
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "var('exit') == 'skipped'"
          },
          "then": [
            {
              "op": "finish",
              "args": {
                "exit": "skipped"
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "var('exit') == 'done'"
              },
              "then": [
                {
                  "op": "finish",
                  "args": {
                    "exit": "done"
                  }
                }
              ],
              "else": [
                {
                  "op": "finish",
                  "args": {
                    "exit": "failed"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
