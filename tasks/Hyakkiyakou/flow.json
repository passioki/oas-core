{
  "schema_version": 1,
  "name": "Hyakkiyakou",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'Hyakkiyakou: 百鬼夜行（庭院→町中→百鬼夜行入口）；核心玩法需要 oashya 目标检测模型 → ⛔'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "6"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW"
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_BACK_RED"
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_GameUi_I_BACK_YOLLOW')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_GameUi_I_BACK_YOLLOW"
                          }
                        }
                      ],
                      "else": [
                        {
                          "op": "click_point",
                          "args": {
                            "x": 48,
                            "y": 43
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            }
          ]
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_GameUi_I_CHECK_MAIN"
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_MAIN_GOTO_TOWN",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_TOWN",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.2
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_TOWN_GOTO_HYAKKIYAKOU",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_TOWN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_KYAKKIYAKOU",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.5
      }
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "'Hyakkiyakou: 已进入百鬼夜行界面；后续撒豆需要 oashya 式神/豆子目标检测 + 窗口后台控制，DSL/引擎无模型推理原语 → blocked'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "8"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW"
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_BACK_RED"
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_GameUi_I_BACK_YOLLOW')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_GameUi_I_BACK_YOLLOW"
                          }
                        }
                      ],
                      "else": [
                        {
                          "op": "click_point",
                          "args": {
                            "x": 48,
                            "y": 43
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            }
          ]
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_GameUi_I_CHECK_MAIN"
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "no_target"
      }
    }
  ]
}
