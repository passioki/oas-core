{
  "schema_version": 1,
  "name": "Orochi",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: Orochi 开始（庭院→探索→御魂→八岐大蛇；单人模式）'"
      }
    },
    {
      "op": "click_point",
      "args": {
        "x": 680,
        "y": 152,
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_EXPLORATION_GOTO_SOUL_ZONE",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_SOUL_ZONES",
          "timeout_ms": 15000
        }
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_Orochi_I_OROCHI",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_SOUL_ZONES",
          "timeout_ms": 3000
        }
      }
    },
    {
      "op": "wait_until",
      "args": {
        "cond": "appear('legacy_Orochi_I_OROCHI_CHECK_10') or appear('legacy_Orochi_I_OROCHI_CHECK_11') or appear('legacy_Orochi_I_OROCHI_CHECK_12') or appear('legacy_Orochi_I_OROCHI_CHECK_13')",
        "timeout_s": 15
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'Orochi: 已进入目标页面'"
      }
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.0
      }
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "'S: 层数选择未迁移（Orochi L_LAYER_LIST 为 RuleList，13 项需滚动，无列表原语）→ 使用游戏内当前层'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_Orochi_I_OROCHI_LOCK')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'Orochi: 默认不锁阵容 → 点击锁定图标解锁'"
          }
        },
        {
          "op": "click",
          "args": {
            "sel": "legacy_Orochi_I_OROCHI_LOCK",
            "requires": {
              "kind": "appear",
              "sel": "legacy_Orochi_I_OROCHI_LOCK",
              "timeout_ms": 3000
            }
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 0.8
          }
        }
      ],
      "else": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'Orochi: 阵容已是解锁状态'"
          }
        }
      ]
    },
    {
      "op": "set_var",
      "args": {
        "name": "did",
        "value": "0"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "param('max_battles')"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Orochi_I_OROCHI_FIRE')"
          },
          "then": [
            {
              "op": "set_var",
              "args": {
                "name": "did",
                "value": "1"
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_Orochi_I_OROCHI_FIRE"
              }
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 战斗准备：点「准备」（I_PREPARE_HIGHLIGHT）'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "5"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "template",
                            "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT"
                          }
                        ]
                      }
                    },
                    {
                      "op": "break"
                    }
                  ]
                }
              ]
            },
            {
              "op": "wait_until",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_BATTLE_INFO')",
                "timeout_s": 25
              }
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 已进入战斗（I_BATTLE_INFO），自动战斗 + 结算处理'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "100"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 2.2
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_WIN')"
                  },
                  "then": [
                    {
                      "op": "log",
                      "args": {
                        "level": "info",
                        "text": "'S: 战斗胜利（I_WIN）'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_WIN"
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 0.6
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_FALSE')"
                  },
                  "then": [
                    {
                      "op": "log",
                      "args": {
                        "level": "warn",
                        "text": "'S: 战斗失败（I_FALSE），点掉结算'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_FALSE"
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 0.8
                      }
                    },
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_Component_GeneralBattle_I_FALSE')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_Component_GeneralBattle_I_FALSE"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "template",
                            "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_GREED_GHOST')"
                  },
                  "then": [
                    {
                      "op": "log",
                      "args": {
                        "level": "info",
                        "text": "'S: 贪吃鬼奖励（I_GREED_GHOST）'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_GREED_GHOST"
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_OVER_GHOST')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_OVER_GHOST"
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_REWARD')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_REWARD"
                      }
                    }
                  ]
                },
                {
                  "op": "click_point",
                  "args": {
                    "x": 640,
                    "y": 690
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Orochi_I_OROCHI_FIRE') or appear('legacy_Orochi_I_OROCHI_CHECK_11')"
                  },
                  "then": [
                    {
                      "op": "break"
                    }
                  ]
                }
              ]
            }
          ],
          "else": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 未见挑战按钮，结束循环'"
              }
            },
            {
              "op": "break"
            }
          ]
        }
      ]
    },
    {
      "op": "loop",
      "args": {
        "n": "12"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break"
            }
          ]
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW"
              }
            }
          ]
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_RED"
              }
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_GameUi_I_CHECK_MAIN"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: Orochi(alone) done，已回庭院'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('did') == '1'"
      },
      "then": [
        {
          "op": "finish",
          "args": {
            "exit": "done"
          }
        }
      ],
      "else": [
        {
          "op": "log",
          "args": {
            "level": "warn",
            "text": "'Orochi: 未发生任何战斗（挑战按钮从未出现）→ failed（不静默成功）'"
          }
        },
        {
          "op": "finish",
          "args": {
            "exit": "failed"
          }
        }
      ]
    }
  ]
}
