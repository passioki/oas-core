{
  "schema_version": 1,
  "name": "FallenSun",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 日轮之陨 开始（庭院 → 探索 → 御魂 → 日轮之陨）'"
      }
    },
    {
      "op": "set_var",
      "args": {
        "name": "exit",
        "value": "'done'"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 庭院 → 探索'"
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_MAIN_GOTO_EXPLORATION",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 探索 → 御魂'"
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_EXPLORATION_GOTO_SOUL_ZONE",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_SOUL_ZONES",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "10"
      },
      "body": [
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_FallenSun_I_FALLEN_SUN')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_FallenSun_I_FALLEN_SUN",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_FallenSun_I_FALLEN_SUN",
                  "timeout_ms": 3000
                }
              }
            }
          ],
          "else": [
            {
              "op": "break",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "op": "wait_until",
      "args": {
        "cond": "appear('legacy_FallenSun_I_FORM_TEAM')",
        "timeout_s": 15
      }
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "'S: 已进入日轮之陨组队页（layer 选择未迁移，见 spec TODO）'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "param('lock_team') == true"
      },
      "then": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_FallenSun_I_FALLEN_SUN_UNLOCK')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_FallenSun_I_FALLEN_SUN_UNLOCK",
                "expect": {
                  "kind": "appear",
                  "sel": "legacy_FallenSun_I_FALLEN_SUN_LOCK",
                  "timeout_ms": 8000
                }
              }
            }
          ],
          "else": []
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_FallenSun_I_FALLEN_SUN_LOCK')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_FallenSun_I_FALLEN_SUN_LOCK",
                "expect": {
                  "kind": "appear",
                  "sel": "legacy_FallenSun_I_FALLEN_SUN_UNLOCK",
                  "timeout_ms": 8000
                }
              }
            }
          ],
          "else": []
        }
      ]
    },
    {
      "op": "while",
      "args": {
        "cond": "var('battles') < param('max_battles')"
      },
      "body": [
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_FallenSun_I_PET_PRESENT')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 猫咪奖励 → 点掉'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "5"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 0.8
                  }
                },
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_Component_GeneralBattle_C_WIN_3"
                      }
                    ],
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Component_GeneralBattle_C_WIN_3",
                      "timeout_ms": 2000
                    }
                  }
                }
              ]
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "not appear('legacy_FallenSun_I_FALLEN_SUN_FIRE')"
          },
          "then": [
            {
              "op": "wait_until",
              "args": {
                "cond": "appear('legacy_FallenSun_I_FALLEN_SUN_FIRE')",
                "timeout_s": 20
              }
            }
          ],
          "else": []
        },
        {
          "op": "click",
          "args": {
            "sel": "legacy_FallenSun_I_FALLEN_SUN_FIRE",
            "requires": {
              "kind": "appear",
              "sel": "legacy_FallenSun_I_FALLEN_SUN_FIRE",
              "timeout_ms": 4000
            },
            "retry": {
              "times": 2,
              "delay_ms": 600,
              "exponential": false
            }
          }
        },
        {
          "op": "wait_until",
          "args": {
            "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT') or appear('legacy_Component_GeneralBattle_I_BATTLE_INFO') or appear('战斗_准备按钮') or appear('战斗_自动按钮')",
            "timeout_s": 30
          }
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 进入战斗（自动战斗），处理 准备/胜利/失败/奖励 直到回到原页面'"
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "60"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                      "timeout_ms": 2000
                    },
                    "expect": {
                      "kind": "vanish",
                      "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                      "timeout_ms": 12000
                    },
                    "retry": {
                      "times": 2,
                      "delay_ms": 600,
                      "exponential": false
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('战斗_准备按钮')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "战斗_准备按钮",
                    "requires": {
                      "kind": "appear",
                      "sel": "战斗_准备按钮",
                      "timeout_ms": 2000
                    },
                    "expect": {
                      "kind": "vanish",
                      "sel": "战斗_准备按钮",
                      "timeout_ms": 12000
                    },
                    "retry": {
                      "times": 2,
                      "delay_ms": 600,
                      "exponential": false
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_WIN') or appear('legacy_Component_GeneralBattle_I_DE_WIN')"
              },
              "then": [
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_Component_GeneralBattle_C_WIN_1"
                      }
                    ]
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_FALSE')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_Component_GeneralBattle_I_FALSE",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Component_GeneralBattle_I_FALSE",
                      "timeout_ms": 2000
                    },
                    "retry": {
                      "times": 2,
                      "delay_ms": 600,
                      "exponential": false
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_REWARD') or appear('legacy_Component_GeneralBattle_I_REWARD_GOLD')"
              },
              "then": [
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_Component_GeneralBattle_C_RANDOM_LEFT"
                      }
                    ]
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            },
            {
              "op": "click_point",
              "args": {
                "x": 640,
                "y": 690
              }
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_FallenSun_I_FALLEN_SUN_FIRE')"
              },
              "then": [
                {
                  "op": "break",
                  "args": {}
                }
              ],
              "else": []
            }
          ]
        },
        {
          "op": "appear",
          "args": {
            "sel": "legacy_FallenSun_I_FALLEN_SUN_FIRE"
          }
        },
        {
          "op": "inc_var",
          "args": {
            "name": "battles",
            "by": 1
          }
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 日轮之陨战斗结束，回到日轮之陨页'"
          }
        }
      ]
    },
    {
      "op": "loop",
      "args": {
        "n": "8"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "not appear('legacy_FallenSun_I_FORM_TEAM')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_BLUE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_BLUE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_BLUE",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_GameUi_I_CHECK_SOUL_ZONES')"
      },
      "then": [
        {
          "op": "click",
          "args": {
            "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
            "requires": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_CHECK_SOUL_ZONES",
              "timeout_ms": 3000
            },
            "expect": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
              "timeout_ms": 12000
            }
          }
        }
      ],
      "else": []
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_GameUi_I_CHECK_EXPLORATION')"
      },
      "then": [
        {
          "op": "click",
          "args": {
            "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
            "requires": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
              "timeout_ms": 3000
            },
            "expect": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_CHECK_MAIN",
              "timeout_ms": 15000
            }
          }
        }
      ],
      "else": []
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 日轮之陨结束'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'no_resource'"
      },
      "then": [
        {
          "op": "finish",
          "args": {
            "exit": "no_resource"
          }
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "var('exit') == 'failed'"
          },
          "then": [
            {
              "op": "finish",
              "args": {
                "exit": "failed"
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "var('exit') == 'done'"
              },
              "then": [
                {
                  "op": "finish",
                  "args": {
                    "exit": "done"
                  }
                }
              ],
              "else": [
                {
                  "op": "finish",
                  "args": {
                    "exit": "done"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
