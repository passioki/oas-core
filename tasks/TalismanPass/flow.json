{
  "schema_version": 1,
  "name": "TalismanPass",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"TalismanPass 开始：庭院 → 花合战 → 一键收取 / 花合战等级奖励 → 可选 1500 签御魂\""
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_MAIN_GOTO_DAILY",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_DAILY",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"已进入花合战/每日页面\""
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_TalismanPass_I_TP_GET_ALL')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"一键收取全部奖励\""
          }
        },
        {
          "op": "click",
          "args": {
            "sel": "legacy_TalismanPass_I_TP_GET_ALL",
            "requires": {
              "kind": "appear",
              "sel": "legacy_TalismanPass_I_TP_GET_ALL",
              "timeout_ms": 3000
            }
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 0.5
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "8"
          },
          "body": [
            {
              "op": "wait",
              "args": {
                "seconds": 0.8
              }
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_REWARD')"
              },
              "then": [
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_GlobalGame_C_UI_REWARD"
                      }
                    ]
                  }
                }
              ],
              "else": []
            }
          ]
        }
      ],
      "else": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"未见一键收取按钮（可能今日已领取）\""
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_TalismanPass_I_TP_GOTO') or appear('legacy_TalismanPass_I_TP_EXP') or appear('legacy_TalismanPass_I_TP_GET_ALL')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"花合战奖励：点右侧奖励页签 click_point(1210,250)（确定性路径，不使用红点匹配）\""
          }
        },
        {
          "op": "click_point",
          "args": {
            "x": 1210,
            "y": 250,
            "requires": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_CHECK_DAILY",
              "timeout_ms": 3000
            }
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "10"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_TalismanPass_I_TP_GET_ALL')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 0.8
              }
            }
          ]
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_TalismanPass_I_TP_GET_ALL')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"奖励页出现一键收取，领取\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_TalismanPass_I_TP_GET_ALL",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_TalismanPass_I_TP_GET_ALL",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 0.5
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "8"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 0.8
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_REWARD')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "region",
                            "sel": "legacy_GlobalGame_C_UI_REWARD"
                          }
                        ]
                      }
                    }
                  ],
                  "else": []
                }
              ]
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"花合战奖励领取完成\""
              }
            }
          ],
          "else": [
            {
              "op": "log",
              "args": {
                "level": "warn",
                "text": "\"奖励页未见一键收取按钮：no-op 继续（今日可能已领取或该页无奖励）\""
              }
            }
          ]
        }
      ],
      "else": [
        {
          "op": "log",
          "args": {
            "level": "warn",
            "text": "\"当前不在花合战页（I_TP_GOTO/I_TP_EXP/I_TP_GET_ALL 均未出现）：奖励分支 no-op\""
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "param('harvest_soul')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"开始收取 1500 签御魂奖励\""
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "8"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "30"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_TalismanPass_I_TP_SOUL_1')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_TalismanPass_I_TP_SOUL_1",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_TalismanPass_I_TP_SOUL_1",
                      "timeout_ms": 3000
                    },
                    "expect": {
                      "kind": "appear",
                      "sel": "legacy_TalismanPass_I_TP_SOUL_2",
                      "timeout_ms": 6000
                    }
                  }
                },
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_TalismanPass_I_TP_SOUL_2",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_TalismanPass_I_TP_SOUL_2",
                      "timeout_ms": 3000
                    },
                    "expect": {
                      "kind": "appear",
                      "sel": "legacy_TalismanPass_I_TP_SOUL_3",
                      "timeout_ms": 6000
                    }
                  }
                },
                {
                  "op": "loop",
                  "args": {
                    "n": "40"
                  },
                  "body": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "not appear('legacy_TalismanPass_I_TP_SOUL_3')"
                      },
                      "then": [
                        {
                          "op": "break"
                        }
                      ],
                      "else": []
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_TalismanPass_I_TP_SOUL_3",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_TalismanPass_I_TP_SOUL_3",
                          "timeout_ms": 3000
                        }
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 1.0
                      }
                    }
                  ]
                }
              ],
              "else": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                }
              ]
            }
          ]
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"御魂奖励收取结束（5 秒空闲计时改为有界循环）\""
          }
        }
      ],
      "else": []
    },
    {
      "op": "loop",
      "args": {
        "n": "8"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                  "timeout_ms": 3000
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"TalismanPass done，已回到庭院\""
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "done"
      }
    }
  ]
}
