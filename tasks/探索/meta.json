{
  "schema_version": 1,
  "template_version": 1,
  "task_id": "探索",
  "name": "探索",
  "version": 1,
  "expire": "daily",
  "category": "daily",
  "description": "庭院→探索→第二十八章→章节地图点妖怪→自动战斗→结算→返回庭院。默认 1 场，可 --param max_battles=N。",
  "entry": {
    "requires": {
      "kind": "appear",
      "sel": "庭院_探索灯笼",
      "timeout_ms": 3000
    }
  },
  "params": [
    {
      "key": "max_battles",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 9
    }
  ],
  "exits": {
    "done": {
      "result": "success"
    },
    "failed": {
      "result": "retryable"
    }
  },
  "capabilities": {
    "checkpoint": true,
    "interruptible": false,
    "duration_hint_s": 120
  },
  "resources": [
    "stamina"
  ],
  "schedule_hint": {
    "windows": [],
    "quota": {
      "per": "day",
      "times": 1
    }
  }
}
