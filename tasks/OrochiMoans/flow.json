{
  "schema_version": 1,
  "name": "OrochiMoans",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "debug",
        "text": "\"main reset prelude\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "5"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "click_point",
          "args": {
            "x": 44,
            "y": 31
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "not appear('ui_main_bar_guide')"
      },
      "then": [
        {
          "op": "click_point",
          "args": {
            "x": 1200,
            "y": 680
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.5
          }
        }
      ],
      "else": []
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "\"OrochiMoans blocked：旧仓 OrochiMoans 没有 script_task.py / 可运行逻辑\""
      }
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "\"「御魂悲鸣」是 Orochi 任务的 zone 选项（Orochi/config.py ELEVEN='悲鸣'）\""
      }
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "\"独立任务无法迁移；需要 Orochi 任务迁移后再以参数/子任务方式复现\""
      }
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "\"原因见 README / migration.json；以下为未迁移项清单\""
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "failed"
      }
    }
  ]
}
