            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_CIRCLE')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_CIRCLE",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_CIRCLE",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": []
                }
              ]
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_ActivityShikigami_I_TO_BATTLE_MAIN')"
      },
      "then": [
        {
          "op": "click",
          "args": {
            "sel": "legacy_GameUi_I_BACK_Y",
            "requires": {
              "kind": "appear",
              "sel": "legacy_ActivityShikigami_I_TO_BATTLE_MAIN",
              "timeout_ms": 3000
            },
            "expect": {
              "kind": "appear",
              "sel": "legacy_GameUi_I_CHECK_MAIN",
              "timeout_ms": 15000
            }
          }
        }
      ],
      "else": []
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 斗技大会结束'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'no_resource'"
      },
      "then": [
        {
          "op": "finish",
          "args": {
            "exit": "no_resource"
          }
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "var('exit') == 'no_target'"
          },
          "then": [
            {
              "op": "finish",
              "args": {
                "exit": "no_target"
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "var('exit') == 'failed'"
              },
              "then": [
                {
                  "op": "finish",
                  "args": {
                    "exit": "failed"
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "var('exit') == 'done'"
                  },
                  "then": [
                    {
                      "op": "finish",
                      "args": {
                        "exit": "done"
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "finish",
                      "args": {
                        "exit": "failed"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
