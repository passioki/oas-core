{
  "schema_version": 1,
  "name": "DyeTrials",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"DyeTrials 开始：庭院 → 灵染试炼 → 循环挑战（自动战斗/结算）\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "30"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_CHALLENGE')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_ACCESS')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_FP_ACCESS",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_FP_ACCESS",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_ACCESS_1')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_FP_ACCESS_1",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_FP_ACCESS_1",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.5
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_TOGGLE_BUTTON')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_TOGGLE_BUTTON",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_TOGGLE_BUTTON",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 0.8
          }
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_DyeTrials_I_FP_CHALLENGE"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"已进入灵染试炼挑战页\""
      }
    },
    {
      "op": "set_var",
      "args": {
        "name": "battles",
        "value": "0"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "param('max_battles')"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_REWARD')"
          },
          "then": [
            {
              "op": "click_target",
              "args": {
                "find": [
                  {
                    "kind": "region",
                    "sel": "legacy_GlobalGame_C_UI_REWARD"
                  }
                ]
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 0.8
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_Restart_I_HARVEST_CHAT_CLOSE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_Restart_I_HARVEST_CHAT_CLOSE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_Restart_I_HARVEST_CHAT_CLOSE",
                  "timeout_ms": 3000
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_BATTLE_SUCCESS')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_BATTLE_SUCCESS",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_BATTLE_SUCCESS",
                  "timeout_ms": 3000
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_CHALLENGE')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"挑战一次\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_FP_CHALLENGE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_FP_CHALLENGE",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "inc_var",
              "args": {
                "name": "battles",
                "by": 1
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            }
          ],
          "else": [
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"挑战循环结束，返回庭院\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "10"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"DyeTrials done\""
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "done"
      }
    }
  ]
}
