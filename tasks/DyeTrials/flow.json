{
  "schema_version": 1,
  "name": "DyeTrials",
  "steps": [
    {
      "op": "if",
      "args": {
        "cond": "not appear('ui_main_bar_guide')"
      },
      "then": [
        {
          "op": "click_point",
          "args": {
            "x": 1200,
            "y": 680
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.5
          }
        }
      ],
      "else": []
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"DyeTrials 开始：庭院 → 灵染试炼入口（ACCESS → ACCESS_1 → TOGGLE，每次外层只动一个）→ 挑战循环\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "6"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_CHALLENGE')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_ACCESS')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"点活动入口 I_FP_ACCESS\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_FP_ACCESS",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_FP_ACCESS",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_CHALLENGE')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_ACCESS_1')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"点 I_FP_ACCESS_1 进入战斗界面\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_FP_ACCESS_1",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_FP_ACCESS_1",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.8
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_FP_CHALLENGE')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_DyeTrials_I_TOGGLE_BUTTON')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "\"点 I_TOGGLE_BUTTON 切换活动页（每个外层轮次最多一次，避免来回切换）\""
              }
            },
            {
              "op": "click",
              "args": {
                "sel": "legacy_DyeTrials_I_TOGGLE_BUTTON",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_DyeTrials_I_TOGGLE_BUTTON",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 2.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_DyeTrials_I_FP_CHALLENGE')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "\"已到达灵染试炼挑战页\""
          }
        },
        {
          "op": "set_var",
          "args": {
            "name": "battles",
            "value": "0"
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "param('max_battles')"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_REWARD')"
              },
              "then": [
                {
                  "op": "click_target",
                  "args": {
                    "find": [
                      {
                        "kind": "region",
                        "sel": "legacy_GlobalGame_C_UI_REWARD"
                      }
                    ]
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 0.8
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_Restart_I_HARVEST_CHAT_CLOSE')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_Restart_I_HARVEST_CHAT_CLOSE",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_Restart_I_HARVEST_CHAT_CLOSE",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DyeTrials_I_BATTLE_SUCCESS')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_DyeTrials_I_BATTLE_SUCCESS",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_DyeTrials_I_BATTLE_SUCCESS",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_DyeTrials_I_FP_CHALLENGE')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "info",
                    "text": "\"挑战一次\""
                  }
                },
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_DyeTrials_I_FP_CHALLENGE",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_DyeTrials_I_FP_CHALLENGE",
                      "timeout_ms": 3000
                    }
                  }
                },
                {
                  "op": "inc_var",
                  "args": {
                    "name": "battles",
                    "by": 1
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 2.0
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_REWARD')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "region",
                            "sel": "legacy_GlobalGame_C_UI_REWARD"
                          }
                        ]
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                }
              ]
            }
          ]
        }
      ],
      "else": [
        {
          "op": "log",
          "args": {
            "level": "warn",
            "text": "\"I_FP_CHALLENGE 始终未出现：活动未开启或入口结构变化，blocked 退出（不再循环点击入口）\""
          }
        },
        {
          "op": "loop",
          "args": {
            "n": "8"
          },
          "body": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
              },
              "then": [
                {
                  "op": "break"
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                      "timeout_ms": 3000
                    }
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                      "timeout_ms": 3000
                    }
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        },
        {
          "op": "finish",
          "args": {
            "exit": "no_target"
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"挑战循环结束，返回庭院\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "10"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "\"DyeTrials done\""
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "done"
      }
    }
  ]
}
