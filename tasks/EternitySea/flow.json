{
  "schema_version": 1,
  "name": "EternitySea",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: EternitySea 开始（庭院→探索→玩法→御魂副本→永生之海；单人模式）'"
      }
    },
    {
      "op": "click_point",
      "args": {
        "x": 680,
        "y": 152,
        "requires": {
          "kind": "appear",
          "sel": "庭院_探索灯笼",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "世界_章节栏",
          "timeout_ms": 10000
        }
      }
    },
    {
      "op": "click_point",
      "args": {
        "x": 1216,
        "y": 186,
        "requires": {
          "kind": "appear",
          "sel": "世界_章节栏",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_Exploration_I_CHECK_PLAY_TITLE",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_EXPLORATION_GOTO_SOUL_ZONE",
        "requires": {
          "kind": "appear",
          "sel": "legacy_Exploration_I_CHECK_PLAY_TITLE",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_SOUL_ZONES",
          "timeout_ms": 15000
        }
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_EternitySea_I_ETERNITY_SEA",
        "requires": {
          "kind": "appear",
          "sel": "legacy_EternitySea_I_ETERNITY_SEA",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_EternitySea_I_FORM_TEAM",
          "timeout_ms": 15000
        }
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 选层（RuleList 未导入：用坐标近似 150+87*(layer-1)，层数 1~4）'"
      }
    },
    {
      "op": "click_point",
      "args": {
        "x": 165,
        "y": "150 + 87 * (param('layer') - 1)",
        "requires": {
          "kind": "appear",
          "sel": "legacy_EternitySea_I_FORM_TEAM",
          "timeout_ms": 3000
        }
      }
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.0
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_EternitySea_I_ETERNITYSEA_UNLOCK')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 点击解锁图标以锁定队伍'"
          }
        },
        {
          "op": "click",
          "args": {
            "sel": "legacy_EternitySea_I_ETERNITYSEA_UNLOCK"
          }
        }
      ]
    },
    {
      "op": "loop",
      "args": {
        "n": "param('max_battles')"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_EternitySea_I_ETERNITY_SEA_FIRE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_EternitySea_I_ETERNITY_SEA_FIRE"
              }
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 战斗准备：点「准备」（I_PREPARE_HIGHLIGHT）'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "5"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "template",
                            "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT"
                          }
                        ]
                      }
                    },
                    {
                      "op": "break"
                    }
                  ]
                }
              ]
            },
            {
              "op": "wait_until",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_BATTLE_INFO')",
                "timeout_s": 25
              }
            },
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 已进入战斗（I_BATTLE_INFO），自动战斗 + 结算处理'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "100"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 2.2
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_WIN')"
                  },
                  "then": [
                    {
                      "op": "log",
                      "args": {
                        "level": "info",
                        "text": "'S: 战斗胜利（I_WIN）'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_WIN"
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 0.6
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_FALSE')"
                  },
                  "then": [
                    {
                      "op": "log",
                      "args": {
                        "level": "warn",
                        "text": "'S: 战斗失败（I_FALSE），点掉结算'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_FALSE"
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 0.8
                      }
                    },
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_Component_GeneralBattle_I_FALSE')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_Component_GeneralBattle_I_FALSE"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
                  },
                  "then": [
                    {
                      "op": "click_target",
                      "args": {
                        "find": [
                          {
                            "kind": "template",
                            "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_GREED_GHOST')"
                  },
                  "then": [
                    {
                      "op": "log",
                      "args": {
                        "level": "info",
                        "text": "'S: 贪吃鬼奖励（I_GREED_GHOST）'"
                      }
                    },
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_GREED_GHOST"
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_OVER_GHOST')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_OVER_GHOST"
                      }
                    }
                  ]
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_REWARD')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_REWARD"
                      }
                    }
                  ]
                },
                {
                  "op": "click_point",
                  "args": {
                    "x": 640,
                    "y": 690
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_EternitySea_I_ETERNITY_SEA_FIRE')"
                  },
                  "then": [
                    {
                      "op": "break"
                    }
                  ]
                }
              ]
            },
            {
              "op": "appear",
              "args": {
                "sel": "legacy_EternitySea_I_ETERNITY_SEA_FIRE"
              }
            }
          ],
          "else": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 未见挑战按钮，结束循环'"
              }
            },
            {
              "op": "break"
            }
          ]
        }
      ]
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_EternitySea_I_BACK_BOTTOM",
        "requires": {
          "kind": "appear",
          "sel": "legacy_EternitySea_I_BACK_BOTTOM",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_SOUL_ZONES",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "12"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('庭院_探索灯笼')"
          },
          "then": [
            {
              "op": "break"
            }
          ]
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW"
              }
            }
          ]
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_RED"
              }
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "庭院_探索灯笼"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: EternitySea(alone) done，已回庭院'"
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "done"
      }
    }
  ]
}
