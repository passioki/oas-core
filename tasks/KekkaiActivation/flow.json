{
  "schema_version": 1,
  "name": "KekkaiActivation",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 结界挂卡 开始（庭院 → 阴阳寮 → 寮结界 → 挂卡界面）'"
      }
    },
    {
      "op": "set_var",
      "args": {
        "name": "exit",
        "value": "'done'"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 庭院 → 阴阳寮'"
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_MAIN_GOTO_GUILD",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_GUILD",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 阴阳寮 → 寮结界'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "12"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiUtilize_I_REALM_SHIN') or appear('legacy_KekkaiUtilize_I_SHI_DEFENSE')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiUtilize_I_PLANT_TREE_CLOSE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_KekkaiUtilize_I_PLANT_TREE_CLOSE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_KekkaiUtilize_I_PLANT_TREE_CLOSE",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiUtilize_I_GUILD_REALM')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_KekkaiUtilize_I_GUILD_REALM",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_KekkaiUtilize_I_GUILD_REALM",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "warn",
        "text": "'S: exchange_before 式神育成换满级：需要 ReplaceShikigami 多步操作（spec ⛔）'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "8"
      },
      "body": [
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiActivation_I_A_HARVEST_EXP') or appear('legacy_KekkaiActivation_I_A_HARVEST_FISH4') or appear('legacy_KekkaiActivation_I_A_HARVEST_KAIKO_4')"
          },
          "then": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KekkaiActivation_I_A_HARVEST_EXP')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_KekkaiActivation_I_A_HARVEST_EXP",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_KekkaiActivation_I_A_HARVEST_EXP",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KekkaiActivation_I_A_HARVEST_FISH4')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_KekkaiActivation_I_A_HARVEST_FISH4",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_KekkaiActivation_I_A_HARVEST_FISH4",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KekkaiActivation_I_A_HARVEST_KAIKO_4')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_KekkaiActivation_I_A_HARVEST_KAIKO_4",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_KekkaiActivation_I_A_HARVEST_KAIKO_4",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        }
      ]
    },
    {
      "op": "loop",
      "args": {
        "n": "15"
      },
      "body": [
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiActivation_I_A_CHECK_CARD') or appear('legacy_KekkaiActivation_I_A_AUTO_INVITE')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiUtilize_I_SHI_CARD')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_KekkaiUtilize_I_SHI_CARD",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_KekkaiUtilize_I_SHI_CARD",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "appear('legacy_KekkaiActivation_I_A_INVITE')"
      },
      "then": [
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: 已有生效的结界卡 → 读取剩余时间（不调度）'"
          }
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiActivation_O_CARD_ALL_TIME')"
          },
          "then": [
            {
              "op": "ocr",
              "args": {
                "sel": "legacy_KekkaiActivation_O_CARD_ALL_TIME"
              }
            }
          ],
          "else": []
        },
        {
          "op": "set_var",
          "args": {
            "name": "exit",
            "value": "'done'"
          }
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiActivation_I_A_ACTIVATE_YELLOW')"
          },
          "then": [
            {
              "op": "log",
              "args": {
                "level": "info",
                "text": "'S: 已选卡未激活 → 点激活并确认直到邀请出现'"
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "15"
              },
              "body": [
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KekkaiActivation_I_A_INVITE')"
                  },
                  "then": [
                    {
                      "op": "break",
                      "args": {}
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                          "timeout_ms": 2000
                        }
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_KekkaiActivation_I_A_ACTIVATE_YELLOW')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_KekkaiActivation_I_A_ACTIVATE_YELLOW",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_KekkaiActivation_I_A_ACTIVATE_YELLOW",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": []
                }
              ]
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_KekkaiActivation_I_A_EMPTY')"
              },
              "then": [
                {
                  "op": "log",
                  "args": {
                    "level": "warn",
                    "text": "'S: 无卡 → 选卡（多行 OCR 取最优卡）DSL 无法表达（spec ⛔）'"
                  }
                },
                {
                  "op": "set_var",
                  "args": {
                    "name": "exit",
                    "value": "'no_target'"
                  }
                }
              ],
              "else": []
            }
          ]
        }
      ]
    },
    {
      "op": "loop",
      "args": {
        "n": "10"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_KekkaiUtilize_I_REALM_SHIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": []
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.0
          }
        }
      ]
    },
    {
      "op": "loop",
      "args": {
        "n": "12"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_GUILD')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                  "timeout_ms": 2500
                }
              }
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_BACK_RED",
                      "timeout_ms": 2500
                    }
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW",
                          "timeout_ms": 2500
                        }
                      }
                    }
                  ],
                  "else": []
                }
              ]
            }
          ]
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'S: 已回庭院'"
      }
    },
    {
      "op": "if",
      "args": {
        "cond": "var('exit') == 'no_target'"
      },
      "then": [
        {
          "op": "finish",
          "args": {
            "exit": "no_target"
          }
        }
      ],
      "else": [
        {
          "op": "if",
          "args": {
            "cond": "var('exit') == 'done'"
          },
          "then": [
            {
              "op": "finish",
              "args": {
                "exit": "done"
              }
            }
          ],
          "else": [
            {
              "op": "finish",
              "args": {
                "exit": "done"
              }
            }
          ]
        }
      ]
    }
  ]
}
