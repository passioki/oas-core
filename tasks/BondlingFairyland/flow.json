{
  "schema_version": 1,
  "name": "BondlingFairyland",
  "steps": [
    {
      "op": "log",
      "args": {
        "level": "debug",
        "text": "\"main reset prelude\""
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "5"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break"
            }
          ],
          "else": []
        },
        {
          "op": "click_point",
          "args": {
            "x": 44,
            "y": 31
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.2
          }
        }
      ]
    },
    {
      "op": "if",
      "args": {
        "cond": "not appear('ui_main_bar_guide')"
      },
      "then": [
        {
          "op": "click_point",
          "args": {
            "x": 1200,
            "y": 680
          }
        },
        {
          "op": "wait",
          "args": {
            "seconds": 1.5
          }
        }
      ],
      "else": []
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'BondlingFairyland: 契灵之境（庭院→探索→契灵→结契区→挑战→捕捉；仅部分迁移）'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "6"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW"
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_BACK_RED"
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_GameUi_I_BACK_YOLLOW')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_GameUi_I_BACK_YOLLOW"
                          }
                        }
                      ],
                      "else": [
                        {
                          "op": "click_point",
                          "args": {
                            "x": 48,
                            "y": 43
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            }
          ]
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_GameUi_I_CHECK_MAIN"
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_MAIN_GOTO_EXPLORATION",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_MAIN",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.0
      }
    },
    {
      "op": "click",
      "args": {
        "sel": "legacy_GameUi_I_EXPLORATION_GOTO_BONDLING_FAIRYLAND",
        "requires": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_EXPLORATION",
          "timeout_ms": 3000
        },
        "expect": {
          "kind": "appear",
          "sel": "legacy_GameUi_I_CHECK_BONDLING_FAIRYLAND",
          "timeout_ms": 12000
        }
      }
    },
    {
      "op": "wait",
      "args": {
        "seconds": 1.5
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'BondlingFairyland: 进入结契区域（I_BALL_AREA / I_CHECK_AREA）'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "10"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_BondlingFairyland_I_CHECK_AREA')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_BondlingFairyland_I_BALL_AREA')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_BondlingFairyland_I_BALL_AREA",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GameUi_I_CHECK_BONDLING_FAIRYLAND",
                      "timeout_ms": 3000
                    }
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            }
          ]
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_BondlingFairyland_I_CHECK_AREA"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'BondlingFairyland: 挑战循环（I_BALL_FIRE→确认→战斗）；捕捉/石头/搜索模式未迁移'"
      }
    },
    {
      "op": "loop",
      "args": {
        "n": "param('limit_count')"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_BondlingFairyland_I_BALL_FIRE')"
          },
          "then": [
            {
              "op": "click",
              "args": {
                "sel": "legacy_BondlingFairyland_I_BALL_FIRE",
                "requires": {
                  "kind": "appear",
                  "sel": "legacy_BondlingFairyland_I_BALL_FIRE",
                  "timeout_ms": 3000
                }
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.0
              }
            },
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_CONFIRM')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                    "requires": {
                      "kind": "appear",
                      "sel": "legacy_GlobalGame_I_UI_CONFIRM",
                      "timeout_ms": 3000
                    }
                  }
                },
                {
                  "op": "wait",
                  "args": {
                    "seconds": 1.0
                  }
                }
              ],
              "else": []
            },
            {
              "op": "wait_until",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')",
                "timeout_s": 25
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "8"
              },
              "body": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                          "timeout_ms": 3000
                        },
                        "expect": {
                          "kind": "vanish",
                          "sel": "legacy_Component_GeneralBattle_I_PREPARE_HIGHLIGHT",
                          "timeout_ms": 10000
                        }
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 1.2
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "break",
                      "args": {}
                    }
                  ]
                }
              ]
            },
            {
              "op": "wait_until",
              "args": {
                "cond": "appear('legacy_Component_GeneralBattle_I_WIN') or appear('legacy_Component_GeneralBattle_I_FALSE') or appear('legacy_Component_GeneralBattle_I_REWARD') or appear('legacy_Component_GeneralBattle_I_REWARD_GOLD')",
                "timeout_s": 180
              }
            },
            {
              "op": "loop",
              "args": {
                "n": "12"
              },
              "body": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_WIN')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_WIN",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_WIN",
                          "timeout_ms": 3000
                        }
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 1.0
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_FALSE')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_FALSE",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_FALSE",
                          "timeout_ms": 3000
                        }
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 1.0
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_REWARD')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_REWARD",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_REWARD",
                          "timeout_ms": 3000
                        }
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 1.2
                      }
                    }
                  ],
                  "else": []
                },
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_Component_GeneralBattle_I_REWARD_GOLD')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_Component_GeneralBattle_I_REWARD_GOLD",
                        "requires": {
                          "kind": "appear",
                          "sel": "legacy_Component_GeneralBattle_I_REWARD_GOLD",
                          "timeout_ms": 3000
                        }
                      }
                    },
                    {
                      "op": "wait",
                      "args": {
                        "seconds": 1.2
                      }
                    }
                  ],
                  "else": []
                }
              ]
            },
            {
              "op": "wait_until",
              "args": {
                "cond": "appear('legacy_BondlingFairyland_I_BALL_FIRE')",
                "timeout_s": 30
              }
            },
            {
              "op": "appear",
              "args": {
                "sel": "legacy_BondlingFairyland_I_BALL_FIRE"
              }
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            }
          ],
          "else": [
            {
              "op": "log",
              "args": {
                "level": "warn",
                "text": "'BondlingFairyland: 未看到挑战按钮 → 结束循环'"
              }
            },
            {
              "op": "break",
              "args": {}
            }
          ]
        }
      ]
    },
    {
      "op": "loop",
      "args": {
        "n": "8"
      },
      "body": [
        {
          "op": "if",
          "args": {
            "cond": "appear('legacy_GameUi_I_CHECK_MAIN')"
          },
          "then": [
            {
              "op": "break",
              "args": {}
            }
          ],
          "else": [
            {
              "op": "if",
              "args": {
                "cond": "appear('legacy_GlobalGame_I_UI_BACK_YELLOW')"
              },
              "then": [
                {
                  "op": "click",
                  "args": {
                    "sel": "legacy_GlobalGame_I_UI_BACK_YELLOW"
                  }
                }
              ],
              "else": [
                {
                  "op": "if",
                  "args": {
                    "cond": "appear('legacy_GlobalGame_I_UI_BACK_RED')"
                  },
                  "then": [
                    {
                      "op": "click",
                      "args": {
                        "sel": "legacy_GlobalGame_I_UI_BACK_RED"
                      }
                    }
                  ],
                  "else": [
                    {
                      "op": "if",
                      "args": {
                        "cond": "appear('legacy_GameUi_I_BACK_YOLLOW')"
                      },
                      "then": [
                        {
                          "op": "click",
                          "args": {
                            "sel": "legacy_GameUi_I_BACK_YOLLOW"
                          }
                        }
                      ],
                      "else": [
                        {
                          "op": "click_point",
                          "args": {
                            "x": 48,
                            "y": 43
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "wait",
              "args": {
                "seconds": 1.2
              }
            }
          ]
        }
      ]
    },
    {
      "op": "appear",
      "args": {
        "sel": "legacy_GameUi_I_CHECK_MAIN"
      }
    },
    {
      "op": "log",
      "args": {
        "level": "info",
        "text": "'BondlingFairyland: 部分完成（捕捉流程 TODO，见 spec）'"
      }
    },
    {
      "op": "finish",
      "args": {
        "exit": "no_target"
      }
    }
  ]
}
