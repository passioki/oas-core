            }
          }
        },
        {
          "op": "log",
          "args": {
            "level": "info",
            "text": "'S: Hunt(netherworld) done，已回庭院'"
          }
        },
        {
          "op": "if",
          "args": {
            "cond": "var('did') == '1'"
          },
          "then": [
            {
              "op": "finish",
              "args": {
                "exit": "done"
              }
            }
          ],
          "else": [
