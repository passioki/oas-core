{
  "schema_version": 1,
  "template_version": 1,
  "task_id": "Secret",
  "name": "秘闻副本",
  "version": 1,
  "expire": "weekly",
  "category": "weekly",
  "description": "庭院→探索→秘闻：进入秘闻副本（需已在副本内），loop max_battles 次「挑战→准备→战斗→回页」，检测 I_SE_FINISHED_1 完成；回庭院。",
  "entry": {
    "requires": {
      "kind": "appear",
      "sel": "庭院_探索灯笼",
      "timeout_ms": 3000
    }
  },
  "params": [
    {
      "key": "max_battles",
      "type": "int",
      "default": 20,
      "min": 1,
      "max": 100
    }
