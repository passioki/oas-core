  "capabilities": {
    "checkpoint": true,
    "interruptible": false,
    "duration_hint_s": 1800
  },
  "resources": [
    "stamina"
  ],
  "schedule_hint": {
    "windows": [],
    "quota": {
      "per": "week",
      "times": 1
    }
  }
