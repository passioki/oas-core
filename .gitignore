/target
**/*.rs.bk

# CD2 click-distribution run logs (runtime artifacts; regenerate with:
#   oasd run ... --clicks-out runs/<name>.clicks.jsonl )
/runs

# runtime state (checkpoint / coordinate memory are machine-local, never shared)
/tasks/*/state
/library/

# release artifacts (zip/stage; regenerate with scripts/package.ps1)
/dist

# scheduler runtime state (machine-local)
/scheduler.state.json
/scheduler.events.jsonl
/scheduler.state.json.lock
/logs

# Runner task runtime values (PR2; machine-local, never committed). The Runner
# writes this next to its live config (`config/values.json` by default).
/config/values.json
# atomic-write temp files / Studio schema-edit backups (runtime artifacts)
*.tmp
/tasks/*/meta.json.bak

# editor request logs (runtime)
**/logs/

# local frame backups from clear (recoverable but not source data)
/frames/.backup/

# local asset backups / deleted-task recovery (machine-local, not source)
/assets/.backup/
/assets/_deleted-tasks/
